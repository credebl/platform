# Stage 1: Build the application
FROM node:26-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS build
RUN apk update && apk upgrade && apk add --no-cache \
    postgresql-client \
    openssl \
    && rm -rf /var/cache/apk/* \
    && npm install -g pnpm@9.15.9 --ignore-scripts
WORKDIR /app
COPY . .
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN pnpm i --frozen-lockfile --ignore-scripts \
    && cd libs/prisma-service && /app/node_modules/.bin/prisma generate

# Stage 2: Create the final image
FROM node:26-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94
RUN apk update && apk upgrade && apk add --no-cache \
    postgresql-client \
    openssl \
    && rm -rf /var/cache/apk/* \
    && addgroup -g 1001 -S nodejs \
    && adduser -S nextjs -u 1001
WORKDIR /app
COPY --from=build --chown=nextjs:nodejs /app ./
# prisma db seed spawns ts-node by name; calling prisma by path (not npx) leaves node_modules/.bin off PATH
ENV PATH=/app/node_modules/.bin:$PATH
USER nextjs
CMD ["sh", "-c", "cd libs/prisma-service && /app/node_modules/.bin/prisma migrate deploy && /app/node_modules/.bin/prisma db seed"]